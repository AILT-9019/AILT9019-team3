# LLM（OpenAI-compatible）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# live | mock
EXTRACTOR_MODE=live

# 学期与时间
TIMEZONE=Asia/Hong_Kong
SEMESTER_START=2026-08-31
SEMESTER_END=2026-12-06

# 上传限制
MAX_UPLOAD_MB=10
MAX_DOC_CHARS=200000
MAX_FILES_PER_UPLOAD=20

# 数据目录
DATA_DIR=./data

# Non-sensitive configuration. Safe to commit.
# Provider selection and API key live in apikey.env (gitignored).

# DeepSeek profile
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Qwen / DashScope profile
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Optional generic overrides (leave commented to use the selected profile):
# LLM_BASE_URL=
# LLM_MODEL=

# live: call the selected provider; mock: local heuristic
EXTRACTOR_MODE=live

# Local web port
PORT=32922

# Semester and time
TIMEZONE=Asia/Hong_Kong
SEMESTER_START=2026-08-31
SEMESTER_END=2026-12-06

# Upload limits
MAX_UPLOAD_MB=10
MAX_DOC_CHARS=200000
MAX_FILES_PER_UPLOAD=20

# Data directory
DATA_DIR=./data
